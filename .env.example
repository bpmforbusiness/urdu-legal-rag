# OCR backend (OpenAI-compatible vision endpoint)
OCR_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
OCR_API_KEY=
OCR_MODEL=deepseek-v4-flash-vision-exp
# required by the opencode-go endpoint; harmless elsewhere
OCR_SESSION_HEADER=X-Opencode-Session
OCR_SESSION_VALUE=
OCR_MAX_PX=1600
OCR_CACHE_DIR=data/ocr_cache

# Answer generation (OpenAI-compatible)
LLM_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Embeddings: intfloat/multilingual-e5-small (default) or BAAI/bge-m3 for long legal text
EMBED_MODEL=intfloat/multilingual-e5-small
